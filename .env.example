# Server Configuration
PORT=3000
NODE_ENV=development

# Session & JWT Secret (Change to a strong random key in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
SESSION_EXPIRY=7d

# Database Path
DB_FILE=./storage/pocket_master.db

# Google OAuth Credentials (for Production / Brief v04)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# App URL
APP_URL=http://localhost:3000
